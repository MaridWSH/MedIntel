# Template for /opt/medintel-sandbox/.env — the live sandbox behind
# https://med.90days.online. Copy it, fill the secrets, chmod 600.
# Never commit the filled-in file.
#
# These values intentionally mirror production (SQLite + all-MiniLM-L6-v2 at
# 384 dimensions) so the demo behaves exactly like citerounds.com.

NEXT_PUBLIC_SITE_URL=https://med.90days.online
NEXT_PUBLIC_API_BASE=https://med.90days.online/api

# Semantic search. Changing the model REQUIRES changing the dimension and
# re-indexing into a fresh collection, or Qdrant rejects every query.
MEDINTEL_QDRANT_COLLECTION=papers_sandbox
MEDINTEL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MEDINTEL_EMBEDDING_DIMENSION=384
MEDINTEL_QUERY_INSTRUCTION=
MEDINTEL_EMBEDDING_BATCH_SIZE=64

MEDINTEL_ENV=staging
MEDINTEL_SECRET_KEY=__SECRET_KEY__
MEDINTEL_SECURE_COOKIES=true
MEDINTEL_ALLOWED_ORIGINS=https://med.90days.online
# nginx reaches the backend across the docker bridge, so the private docker
# range must be trusted for X-Forwarded-For.
MEDINTEL_TRUSTED_PROXY_NETWORKS=172.16.0.0/12
MEDINTEL_ADMIN_EMAILS=
MEDINTEL_ACCESS_TOKEN_MINUTES=15
MEDINTEL_ENABLE_DOCS=false
MEDINTEL_PIPELINE_VERSION=2026-07-14.2
MEDINTEL_REQUIRE_CURRENT_PIPELINE=false
# Left empty so cookies are host-scoped to med.90days.online automatically.
MEDINTEL_COOKIE_DOMAIN=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@med.90days.online
MEDINTEL_RESET_URL=https://med.90days.online/reset-password
